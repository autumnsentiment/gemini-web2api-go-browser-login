{
  "manifest_version": 3,
  "name": "Gemini Cookie Sync",
  "version": "1.0.5",
  "description": "刷新已有 Gemini 页面（不新开页面）读取会话 Cookie，每次刷新后有冷却窗口，冷却内提取、超时再刷新；推送到 gemini-web2api 控制器写入 cookie 池。",
  "minimum_chrome_version": "110",
  "permissions": [
    "cookies",
    "storage",
    "alarms",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://*.google.com/*",
    "https://*.googleusercontent.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://gemini.google.com/*",
      "https://accounts.google.com/*",
      "https://www.google.com/*",
      "https://*.google.com/*",
      "http://127.0.0.1/*",
      "http://localhost/*"
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Gemini Cookie Sync",
    "default_popup": "popup.html"
  }
}
