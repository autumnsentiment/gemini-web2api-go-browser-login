{
  "manifest_version": 3,
  "name": "Gemini Cookie Sync",
  "version": "1.1.7",
  "description": "绑定一个指定的 Gemini 标签页，按页面实际登录的账号读取会话 Cookie；不扫描其他账号，不自动新建页面。",
  "minimum_chrome_version": "110",
  "permissions": [
    "cookies",
    "storage",
    "alarms",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://*.google.com/*",
    "https://*.googleusercontent.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*",
    "http://*/*",
    "https://*/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://gemini.google.com/*",
      "https://accounts.google.com/*",
      "https://www.google.com/*",
      "https://*.google.com/*",
      "http://127.0.0.1/*",
      "http://localhost/*"
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Gemini Cookie Sync",
    "default_popup": "popup.html"
  }
}
