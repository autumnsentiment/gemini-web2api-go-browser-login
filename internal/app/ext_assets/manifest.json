{
  "manifest_version": 3,
  "name": "Gemini Cookie Sync",
  "version": "1.1.0",
  "description": "读取已登录 Gemini 会话的 Cookie 并推送到 gemini-web2api（控制器或服务端 ingest）。支持本机浏览器直连远程服务器，抓取前不刷新页面，仅在会话失效时刷新。",
  "minimum_chrome_version": "110",
  "permissions": [
    "cookies",
    "storage",
    "alarms",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://*.google.com/*",
    "https://*.googleusercontent.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*",
    "http://*/*",
    "https://*/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://gemini.google.com/*",
      "https://accounts.google.com/*",
      "https://www.google.com/*",
      "https://*.google.com/*",
      "http://127.0.0.1/*",
      "http://localhost/*"
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Gemini Cookie Sync",
    "default_popup": "popup.html"
  }
}
